---
/**
 * Minimal outline icon system.
 *
 * Created now (not requested by name in any spec) because
 * docs/BRAND_GUIDELINES.md requires "consistent stroke width across the
 * whole site" for icons, and docs/HOMEPAGE_SPECIFICATION.md reuses icons in
 * multiple future sections (Features, Trust, FAQ) beyond this one. A shared
 * component is the only way to guarantee that consistency instead of each
 * section re-authoring its own SVGs with drifting stroke widths.
 *
 * Deliberately hand-authored inline SVGs rather than an icon library
 * dependency — zero added JavaScript, zero install footprint, and it keeps
 * the "simple outline, no cartoons/emoji" rule enforceable in one place.
 * Add new icon names here as later sections need them.
 *
 * Extended for Phase 2.3 (How It Works) with `layers`/`repeat`/
 * `check-circle` — reused as-is by Why nextCitizen (Phase 2.2) rather than
 * duplicated, per the "do not introduce another icon implementation" rule.
 *
 * Extended for Phase 2.4 (Features) with `list`/`clipboard-check`/`cards`/
 * `message-circle`/`bar-chart`/`rotate-ccw`. These are deliberately NOT
 * reused from How It Works' `layers`/`check-circle`/`repeat` even though
 * some concepts overlap (e.g. flashcards vs. "choose how you study") —
 * repeating the same icon within one scroll of the page reads as a design
 * oversight, not intentional reuse, so Features gets its own visually
 * distinct set.
 *
 * Extended for Phase 5 (Trust) with `map-pin` (Local Answers) and `info`
 * (No Government Affiliation) — two genuinely new concepts not covered by
 * any existing icon. Trust's other two items deliberately *reuse*
 * `shield-check` (Why nextCitizen's "official/verified" concept) and
 * `message-circle` (Features' "Interview Practice" concept) instead of
 * inventing near-duplicate icons — Trust sits several sections below both,
 * not within one scroll of either, so reuse here reinforces the same
 * meaning rather than reading as accidental repetition.
 */

import type { IconName } from '@/types/icon';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'shield-check':
    'M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z|M9 12l2 2 4-4',
  clock: 'M12 7.5V12l3 2|M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0z',
  lightbulb:
    'M9 18h6|M10 21h4|M12 3a6 6 0 0 0-3.5 10.9c.6.45 1 .95 1.1 1.6h4.8c.1-.65.5-1.15 1.1-1.6A6 6 0 0 0 12 3z',
  'book-open':
    'M12 6c-1.5-1.2-3.6-1.8-6-1.8v13c2.4 0 4.5.6 6 1.8|M12 6c1.5-1.2 3.6-1.8 6-1.8v13c-2.4 0-4.5.6-6 1.8|M12 6v13',
  layers: 'M12 3l9 5-9 5-9-5 9-5z|M3 13l9 5 9-5',
  repeat:
    'M4 12a8 8 0 0 1 13.5-5.8L20 8|M20 4v4h-4|M20 12a8 8 0 0 1-13.5 5.8L4 16|M4 20v-4h4',
  'check-circle': 'M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0z|M8.5 12.5l2.5 2.5 5-5',
  list: 'M3 7h.01|M3 12h.01|M3 17h.01|M8 7h13|M8 12h13|M8 17h13',
  'clipboard-check':
    'M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z|M6 6h12a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z|M9.5 13l2 2 4-4.5',
  cards:
    'M9 4h11a1 1 0 0 1 1 1v10|M4.5 8h11a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z',
  'message-circle':
    'M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-4-.99L3 21l1.99-5.5A8.5 8.5 0 1 1 21 11.5z',
  'bar-chart': 'M4 20V11|M12 20V4|M20 20v-6',
  'rotate-ccw': 'M3 12a9 9 0 1 0 3-6.7|M3 4v5h5',
  'map-pin': 'M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12z|M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  info: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17z|M12 11v5.5|M12 8h.01',
};

const segments = paths[name].split('|');
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {segments.map((d) => <path d={d} />)}
</svg>
